				<key>ActionName</key>
				<string>AppleScriptを実行</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>on run {input, parameters}
	set results to {}
	
	-- このアプリの場所を results に追加する(シェルスクリプトで tools フォルダを求める)
	-- MEMO: Finder の前面の窓(insertion location)を使うと、別の窓から D&amp;D したときに違う場所になる
	set end of results to POSIX path of (path to me)
	
	-- 入力パスを POSIX パスに変換して results に追加する
	repeat with i in input
		set p to POSIX path of i as text
		set end of results to p
	end repeat
	
	return results
end run</string>
