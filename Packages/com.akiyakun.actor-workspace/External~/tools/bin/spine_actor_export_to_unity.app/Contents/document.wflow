				<key>ActionName</key>
				<string>シェルスクリプトを実行</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># AppleScript から、このアプリの場所と、ドラッグ&amp;ドロップされたものの一覧が渡される

# MEMO: ここで出力したものは、次のアクションでダイアログに出す。失敗しても終了コードは 0 にする
#       (0 以外を返すと、Automator のエラーの知らせだけが出て、出力のダイアログが出ない)

# tools フォルダ(このアプリがある bin の 1 つ上)をカレントにする
if ! cd "$(dirname "$1")/.."; then
	echo "[エラー] アプリのある場所に移れません: $1"
	exit 0
fi
# アプリの場所を引数から外す
shift 1

if [ ! -x "./bin/spine_actor_export_to_unity" ]; then
	echo "[エラー] このアプリと同じフォルダに spine_actor_export_to_unity がありません: $(pwd)/bin"
	echo "(ダウンロードしたアプリで、場所が /private/var/folders/... になっているときは、xattr -dr com.apple.quarantine &lt;アプリ&gt; で quarantine を外してください)"
	exit 0
fi
if [ $# -eq 0 ]; then
	echo "書き出すフォルダを、このアプリにドラッグ&amp;ドロップしてください。"
	exit 0
fi

# エクスポーター実行
# 出力(標準エラー出力も)は、次のアクションでダイアログに出す(Mac ではコンソールが見えないため)
# MEMO: 書き出しの設定(bin/spine_export_setting.json があればそれ)は、実行ファイルが選ぶ
# MEMO: 失敗したときは実行ファイルがエラーのダイアログを出すので、終了コードは Automator に返さない
./bin/spine_actor_export_to_unity --inputs "$@" 2&gt;&amp;1
exit 0
</string>
