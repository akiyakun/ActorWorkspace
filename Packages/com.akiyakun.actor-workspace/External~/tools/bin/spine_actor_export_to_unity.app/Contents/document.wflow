				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>on run {input, parameters}
	-- 前のアクションの出力(1 行ずつのリスト)を、改行でつないでダイアログに出す
	if class of input is not list then set input to paragraphs of (input as text)
	set lineCount to count of input
	-- MEMO: 長いとダイアログが画面に収まらないので、最後の maxLines 行だけ出す
	set maxLines to 40
	set header to ""
	if lineCount &gt; maxLines then
		set header to "(最初の " &amp; (lineCount - maxLines) &amp; " 行は省きました)" &amp; linefeed
		set input to items (lineCount - maxLines + 1) thru lineCount of input
	end if
	set oldDelimiters to AppleScript's text item delimiters
	set AppleScript's text item delimiters to linefeed
	set message to header &amp; (input as text)
	set AppleScript's text item delimiters to oldDelimiters
	display dialog message buttons {"OK"} default button "OK" with title "spine_actor_export_to_unity"
	return input
end run</string>
