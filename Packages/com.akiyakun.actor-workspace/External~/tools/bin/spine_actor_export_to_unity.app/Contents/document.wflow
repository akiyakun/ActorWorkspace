				<key>ActionName</key>
				<string>シェルスクリプトを実行</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># AppleScript から、このアプリの場所と、ドラッグ&amp;ドロップされたものの一覧が渡される

# 知らせを出す(このスクリプトの出力は、どこにも出ないため)
# 使い方: alert &lt;メッセージ&gt; [critical|informational]
alert() {
	osascript -e 'on run argv' -e 'if item 2 of argv is "critical" then' -e 'display alert "spine_actor_export_to_unity" message (item 1 of argv) as critical' -e 'else' -e 'display alert "spine_actor_export_to_unity" message (item 1 of argv)' -e 'end if' -e 'end run' "$1" "${2:-critical}" &gt; /dev/null
}

# tools フォルダ(このアプリがある bin の 1 つ上)をカレントにする
if ! cd "$(dirname "$1")/.."; then
	alert "アプリのある場所に移れません: $1"
	exit 0
fi
# アプリの場所を引数から外す
shift 1

if [ ! -x "./bin/spine_actor_export_to_unity" ]; then
	alert "このアプリと同じフォルダに spine_actor_export_to_unity がありません: $(pwd)/bin
(ダウンロードしたアプリで、場所が /private/var/folders/... になっているときは、xattr -dr com.apple.quarantine &lt;アプリ&gt; で quarantine を外してください)"
	exit 0
fi
if [ $# -eq 0 ]; then
	alert "書き出すフォルダを、このアプリにドラッグ&amp;ドロップしてください。" informational
	exit 0
fi

# エクスポーター実行
# MEMO: Spine の場所と書き出しの設定(bin/spine_export_setting.json があればそれ)は、実行ファイルが選ぶ
# MEMO: 終わったとき・失敗したとき(終了コード 1)は、実行ファイルがダイアログで知らせるので、終了コードは Automator に返さない
#       (0 以外を返すと、Automator のエラーの知らせが重なる)
./bin/spine_actor_export_to_unity --inputs "$@"
exit_code=$?
# 実行ファイルがダイアログを出す前に止まったとき(起動できない、強制終了されたなど)は、ここで知らせる
if [ $exit_code -ne 0 ] &amp;&amp; [ $exit_code -ne 1 ]; then
	alert "spine_actor_export_to_unity が途中で止まりました(終了コード $exit_code)。"
fi
exit 0
</string>
